# ===========================================
# EXAMPLE FILE - Copy to .env.j2 and fill with real values
# ===========================================

# Server Configuration (Dynamic IP) - DON'T CHANGE THESE!
SERVER_IP={{ ansible_host }}
HOST=https://{{ ansible_host }}

# ===========================================
# Database Configuration - CHANGE THESE!
# ===========================================
DB_NAME=myDb
DB_HOST=mariadb
DB_USER=wpuser
DB_PASSWORD=your_secure_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here

# ===========================================
# WordPress Configuration - CHANGE THESE!
# ===========================================
WP_SITE_TITLE=My WordPress Site
WP_ADMIN_USER=your_admin_username
WP_ADMIN_PASS=your_secure_password_here
WP_ADMIN_EMAIL=your_email@example.com
